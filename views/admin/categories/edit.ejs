<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Categoría</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #ff6b6b;
            --secondary-color: #ff9f43;
            --dark-color: #2d3436;
            --light-color: #f9f9f9;
            --success-color: #20bf6b;
            --warning-color: #f7b731;
            --danger-color: #eb4d4b;
        }
        
        body {
            background-color: #f5f7fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }
        
        .form-container {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            padding: 30px;
            margin: 50px auto;
            max-width: 700px;
        }
        
        .form-header {
            text-align: center;
            margin-bottom: 30px;
            position: relative;
            padding-bottom: 20px;
        }
        
        .form-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--dark-color);
            margin-bottom: 10px;
            position: relative;
            display: inline-block;
        }
        
        .form-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 70px;
            height: 3px;
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            border-radius: 3px;
        }
        
        .form-card {
            border: none;
            overflow: hidden;
            padding: 20px 30px;
        }
        
        .form-label {
            font-weight: 600;
            color: #576574;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }
        
        .form-control {
            border: 2px solid #edf2f7;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }
        
        .form-control:focus {
            border-color: rgba(255, 107, 107, 0.5);
            box-shadow: 0 0 0 0.25rem rgba(255, 107, 107, 0.25);
        }
        
        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }
        
        .btn-group {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }
        
        .btn {
            padding: 12px 25px;
            font-weight: 600;
            border-radius: 30px;
            letter-spacing: 0.3px;
            transition: all 0.3s ease;
            flex: 1;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            box-shadow: 0 5px 15px rgba(255, 107, 107, 0.3);
        }
        
        .btn-primary:hover {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(255, 107, 107, 0.4);
        }
        
        .btn-secondary {
            background-color: #f1f2f6;
            border-color: #f1f2f6;
            color: #576574;
        }
        
        .btn-secondary:hover {
            background-color: #dfe4ea;
            border-color: #dfe4ea;
            color: #2d3436;
            transform: translateY(-3px);
        }
        
        .form-icon {
            display: block;
            font-size: 2.5rem;
            color: var(--primary-color);
            text-align: center;
            margin-bottom: 10px;
        }
        
        .form-subtitle {
            text-align: center;
            color: #7f8c8d;
            margin-bottom: 30px;
            font-size: 1rem;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-text {
            color: #8395a7;
            font-size: 0.85rem;
            margin-top: 8px;
        }
        
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
        
        .back-link:hover {
            color: var(--secondary-color);
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-container">
            <div class="form-header">
                <i class="fas fa-tags form-icon"></i>
                <h2 class="form-title">Editar Categoría</h2>
                <p class="form-subtitle">Actualiza los detalles de la categoría seleccionada</p>
            </div>
            
            <div class="form-card">
                <form action="/categories/edit/<%= category._id %>?_method=PUT" method="POST">
                    <div class="form-group">
                        <label for="name" class="form-label">Nombre de la Categoría</label>
                        <input type="text" id="name" name="name" class="form-control" 
                               value="<%= category.name %>" required
                               placeholder="Ej: Electrónicos, Ropa, Accesorios...">
                        <div class="form-text">
                            <i class="fas fa-info-circle me-1"></i> 
                            El nombre debe ser único y descriptivo.
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="description" class="form-label">Descripción</label>
                        <textarea id="description" name="description" class="form-control" 
                                  placeholder="Describe brevemente esta categoría de productos..."><%= category.description %></textarea>
                        <div class="form-text">
                            <i class="fas fa-info-circle me-1"></i>
                            Una buena descripción ayuda a los clientes a encontrar los productos correctos.
                        </div>
                    </div>
                    
                    <div class="btn-group">
                        <a href="/admin/categories" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Actualizar Categoría
                        </button>
                    </div>
                </form>
            </div>
            
            <a href="/admin/categories" class="back-link">
                <i class="fas fa-arrow-left me-1"></i> Volver a todas las categorías
            </a>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>