<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Producto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h2 class="text-center mb-4">Crear Producto</h2>
        <form action="/admin/products" method="POST" enctype="multipart/form-data">
            <!-- Nombre del producto -->
            <div class="mb-3">
                <label for="name" class="form-label">Nombre del Producto</label>
                <input type="text" id="name" name="name" class="form-control" required>
            </div>

            <!-- Slug del producto -->
            <!-- <div class="mb-3">
                <label for="slug" class="form-label">Slug</label>
                <input type="text" id="slug" name="slug" class="form-control" required>
            </div> -->

            <!-- Descripción -->
            <div class="mb-3">
                <label for="description" class="form-label">Descripción</label>
                <textarea id="description" name="description" class="form-control" rows="3" required></textarea>
            </div>

            <!-- Precio -->
            <div class="mb-3">
                <label for="price" class="form-label">Precio</label>
                <input type="number" id="price" name="price" class="form-control" min="0" step="0.01" required>
            </div>

            <!-- Precio de comparación -->
            <div class="mb-3">
                <label for="comparePrice" class="form-label">Precio de Comparación (opcional)</label>
                <input type="number" id="comparePrice" name="comparePrice" class="form-control" min="0" step="0.01">
            </div>

            <!-- Categoría -->
            <div class="mb-3">
                <label for="category" class="form-label">Categoría</label>
                <select id="category" name="category" class="form-select" required>
                    <% categories.forEach(category => { %>
                        <option value="<%= category._id %>"><%= category.name %></option>
                    <% }); %>
                </select>
            </div>

            <!-- Stock -->
            <div class="mb-3">
                <label for="stock" class="form-label">Stock</label>
                <input type="number" id="stock" name="stock" class="form-control" min="0" required>
            </div>

            <!-- Imágenes -->
            <div class="mb-3">
                <label for="images" class="form-label">Imágenes</label>
                <input type="file" id="images" name="images" class="form-control" multiple>
            </div>

            <!-- Producto destacado -->
            <div class="form-check mb-3">
                <input type="checkbox" id="featured" name="featured" class="form-check-input">
                <label for="featured" class="form-check-label">¿Producto destacado?</label>
            </div>

            <!-- Producto en oferta -->
            <div class="form-check mb-3">
                <input type="checkbox" id="onSale" name="onSale" class="form-check-input">
                <label for="onSale" class="form-check-label">¿Producto en oferta?</label>
            </div>

            <!-- Botón de envío -->
            <button type="submit" class="btn btn-primary">Crear Producto</button>
        </form>
    </div>
</body>
</html>