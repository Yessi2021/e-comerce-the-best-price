<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Producto</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #ff6b6b;
            --secondary-color: #ff9f43;
            --dark-color: #2d3436;
            --light-color: #f9f9f9;
            --success-color: #20bf6b;
            --warning-color: #f7b731;
            --danger-color: #eb4d4b;
        }
        
        body {
            background-color: #f5f7fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .form-container {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            padding: 30px;
            margin-top: 2rem;
            margin-bottom: 2rem;
        }
        
        .form-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #f1f1f1;
            padding-bottom: 15px;
        }
        
        .form-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--dark-color);
            margin: 0;
            position: relative;
            padding-left: 15px;
        }
        
        .form-title::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 5px;
            background: linear-gradient(to bottom, var(--primary-color), var(--secondary-color));
            border-radius: 3px;
        }
        
        .btn-back {
            background-color: #f1f2f6;
            color: #576574;
            border: none;
            padding: 10px 20px;
            border-radius: 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-back:hover {
            background-color: #dfe4ea;
            transform: translateY(-2px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.05);
            color: #2d3436;
        }
        
        .form-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            overflow: hidden;
        }
        
        .form-card-body {
            padding: 30px;
        }
        
        .form-label {
            font-weight: 600;
            color: #576574;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }
        
        .form-control, .form-select {
            border: 2px solid #edf2f7;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: rgba(255, 107, 107, 0.5);
            box-shadow: 0 0 0 0.25rem rgba(255, 107, 107, 0.25);
        }
        
        .input-group-text {
            background-color: #f1f2f6;
            border: 2px solid #edf2f7;
            border-right: none;
            color: #576574;
            font-weight: 600;
        }
        
        .form-check-input {
            width: 20px;
            height: 20px;
            margin-top: 0.15rem;
            cursor: pointer;
        }
        
        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        
        .form-check-label {
            padding-left: 5px;
            cursor: pointer;
        }
        
        textarea.form-control {
            min-height: 150px;
        }
        
        .product-image-container {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 15px;
        }
        
        .product-image-preview {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
            border: 3px solid #edf2f7;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        
        .product-image-preview:hover {
            transform: scale(1.05);
            border-color: var(--primary-color);
        }
        
        .form-text {
            color: #8395a7;
            font-size: 0.85rem;
            margin-top: 8px;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            border-radius: 30px;
            padding: 12px 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(255, 107, 107, 0.3);
        }
        
        .btn-primary:hover {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(255, 107, 107, 0.4);
        }
        
        .btn-secondary {
            background-color: #f1f2f6;
            border-color: #f1f2f6;
            color: #576574;
            border-radius: 30px;
            padding: 12px 30px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-secondary:hover {
            background-color: #dfe4ea;
            border-color: #dfe4ea;
            color: #2d3436;
            transform: translateY(-3px);
        }
        
        .form-section {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #edf2f7;
        }
        
        .form-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        
        .form-section-title {
            font-size: 1.2rem;
            color: var(--dark-color);
            margin-bottom: 20px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container form-container">
        <div class="form-header">
            <h2 class="form-title">Editar Producto</h2>
            <a href="/admin/products" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> Volver a Productos
            </a>
        </div>

        <div class="form-card">
            <div class="form-card-body">
                <form action="/admin/products/<%= product._id %>" method="POST" enctype="multipart/form-data">
                    <div class="form-section">
                        <h3 class="form-section-title">Información Básica</h3>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="name" class="form-label">Nombre del Producto</label>
                                <input type="text" class="form-control" id="name" name="name" value="<%= product.name %>" required>
                            </div>
                            <div class="col-md-6">
                                <label for="category" class="form-label">Categoría</label>
                                <select class="form-select" id="category" name="category">
                                    <option value="">Seleccionar categoría</option>
                                    <% categories.forEach(category => { %>
                                        <option value="<%= category._id %>" <%= product.category && product.category.equals(category._id) ? 'selected' : '' %>>
                                            <%= category.name %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="price" class="form-label">Precio</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="price" name="price" step="0.01" value="<%= product.price %>" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="comparePrice" class="form-label">Precio Comparativo (opcional)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="comparePrice" name="comparePrice" step="0.01" value="<%= product.comparePrice %>">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <label for="stock" class="form-label">Stock</label>
                                <input type="number" class="form-control" id="stock" name="stock" value="<%= product.stock %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Opciones Adicionales</label>
                                <div class="d-flex gap-4 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="featured" name="featured" <%= product.featured ? 'checked' : '' %>>
                                        <label class="form-check-label" for="featured">
                                            Producto Destacado
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="onSale" name="onSale" <%= product.onSale ? 'checked' : '' %>>
                                        <label class="form-check-label" for="onSale">
                                            En Oferta
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">Descripción</h3>
                        <div class="mb-3">
                            <textarea class="form-control" id="description" name="description" rows="4" placeholder="Describe las características y beneficios del producto..."><%= product.description %></textarea>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="form-section-title">Imágenes</h3>
                        <div class="mb-4">
                            <label class="form-label">Imágenes Actuales</label>
                            <div class="product-image-container">
                                <% if (product.images && product.images.length > 0) { %>
                                    <% product.images.forEach((image, index) => { %>
                                        <div class="position-relative">
                                            <img src="<%= image %>" alt="Imagen <%= index + 1 %>" class="product-image-preview">
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p class="text-muted">No hay imágenes para este producto</p>
                                <% } %>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="images" class="form-label">Agregar Nuevas Imágenes</label>
                            <input type="file" class="form-control" id="images" name="images" multiple accept="image/*">
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i> Puedes seleccionar hasta 5 imágenes. Formatos permitidos: JPG, PNG, GIF.
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-end mt-4">
                        <a href="/admin/products" class="btn btn-secondary">
                            <i class="fas fa-times me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS y Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>