<style>
  /* Estilos mejorados para el footer */
  .footer {
    background-color: #1a1a1a;
    color: #f5f5f5;
    padding: 60px 0 30px;
    margin-top: 60px;
    position: relative;
  }
  
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(90deg, #ff6b6b, #ff9f43, #ff6b6b);
  }
  
  .footer-columns {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 40px;
  }
  
  .footer-column {
    flex: 1;
    min-width: 250px;
    margin-bottom: 25px;
    padding-right: 30px;
  }
  
  .footer-title {
    color: #ff6b6b;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 10px;
    letter-spacing: 1px;
  }
  
  .footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 50px;
    height: 2px;
    background-color: #ff6b6b;
  }
  
  .footer-column p {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 20px;
    color: #b0b0b0;
  }
  
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-link {
    margin-bottom: 12px;
  }
  
  .footer-link a {
    color: #b0b0b0;
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    display: inline-block;
    position: relative;
    padding-left: 15px;
  }
  
  .footer-link a::before {
    content: '›';
    position: absolute;
    left: 0;
    top: 0;
    color: #ff6b6b;
    transition: all 0.3s ease;
  }
  
  .footer-link a:hover {
    color: #fff;
    transform: translateX(5px);
  }
  
  .footer-link a:hover::before {
    transform: translateX(3px);
  }
  
  .footer-link a i {
    margin-right: 8px;
    font-size: 1.1rem;
    color: #ff6b6b;
    transition: all 0.3s ease;
  }
  
  .footer-link a:hover i {
    transform: scale(1.2);
  }
  
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 20px;
    text-align: center;
  }
  
  .footer-bottom p {
    color: #888;
    font-size: 0.9rem;
    margin: 0;
  }
  
  /* Animación de hover para los íconos sociales */
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: rgba(255, 107, 107, 0.1);
    color: #ff6b6b;
    margin-right: 10px;
    transition: all 0.3s ease;
  }
  
  .social-icon:hover {
    background-color: #ff6b6b;
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(255, 107, 107, 0.4);
  }
  
  /* Estilos responsivos */
  @media (max-width: 768px) {
    .footer-columns {
      flex-direction: column;
    }
    
    .footer-column {
      width: 100%;
      padding-right: 0;
      margin-bottom: 30px;
    }
  }
</style>

<footer class="footer">
  <div class="container">
    <div class="footer-columns">
      <div class="footer-column">
        <h3 class="footer-title">Sobre Nosotros</h3>
        <p>The Best Price es tu destino ideal para productos de calidad a precios competitivos. Estamos comprometidos a ofrecer un servicio al cliente excepcional y una experiencia de compra sin inconvenientes.</p>
      </div>
      
      <div class="footer-column">
        <h3 class="footer-title">Enlaces Rápidos</h3>
        <ul class="footer-links">
          <li class="footer-link"><a href="/">Inicio</a></li>
          <li class="footer-link"><a href="/category/all">Tienda</a></li>
          <li class="footer-link"><a href="#">Acerca de</a></li>
          <li class="footer-link"><a href="#">Contacto</a></li>
          <li class="footer-link"><a href="#">Preguntas Frecuentes</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3 class="footer-title">Servicio al Cliente</h3>
        <ul class="footer-links">
          <li class="footer-link"><a href="#">Política de Envíos</a></li>
          <li class="footer-link"><a href="#">Devoluciones y Reembolsos</a></li>
          <li class="footer-link"><a href="#">Política de Privacidad</a></li>
          <li class="footer-link"><a href="#">Términos del Servicio</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3 class="footer-title">Conéctate con Nosotros</h3>
        <div class="social-icons">
          <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
          <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
          <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
          <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
        </div>
        <p style="margin-top: 15px;">Suscríbete a nuestro boletín para recibir ofertas exclusivas y novedades.</p>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> The Best Price. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<script>
  // Alternar menú móvil
  const mobileMenuButton = document.querySelector('.mobile-menu-button');
  const header = document.querySelector('.header');
  
  if (mobileMenuButton) {
    mobileMenuButton.addEventListener('click', () => {
      header.classList.toggle('mobile-menu-open');
    });
  }
  
  // Galería de imágenes del producto
  const mainImage = document.querySelector('.product-main-image');
  const thumbnails = document.querySelectorAll('.product-thumbnail');
  
  if (mainImage && thumbnails.length > 0) {
    thumbnails.forEach(thumbnail => {
      thumbnail.addEventListener('click', () => {
        mainImage.src = thumbnail.src;
        thumbnails.forEach(t => t.classList.remove('active'));
        thumbnail.classList.add('active');
      });
    });
  }
  
  // Botones de cantidad
  const quantityBtns = document.querySelectorAll('.quantity-btn');
  
  if (quantityBtns.length > 0) {
    quantityBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const input = btn.parentElement.querySelector('.quantity-input');
        const currentValue = parseInt(input.value);
        
        if (btn.classList.contains('quantity-increase')) {
          input.value = currentValue + 1;
        } else if (btn.classList.contains('quantity-decrease') && currentValue > 1) {
          input.value = currentValue - 1;
        }
      });
    });
  }
</script>
