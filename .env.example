# Variables de entorno de ejemplo - Copia este archivo como .env y configura los valores
# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/your-database

# Configuración del servidor
PORT=3000
NODE_ENV=development

# Secreto para las sesiones
SESSION_SECRET=tu_secreto_super_seguro

# URL de la aplicación (para ping de keep-alive si es necesario)
APP_URL=http://localhost:3000
ENABLE_KEEP_ALIVE=false